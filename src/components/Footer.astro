---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const year = new Date().getFullYear();
const githubURL = 'https://github.com/Iajensen222222/AuraShell';
const licenseURL = 'https://github.com/Iajensen222222/AuraShell/blob/main/LICENSE';
---

<footer class="footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <span class="brand-name">AuraShell</span>
      <p class="brand-tagline">Customize every pixel of Windows 11.</p>
    </div>

    <nav class="footer-nav" aria-label="Footer">
      <div class="footer-col">
        <h3 class="footer-heading">Product</h3>
        <ul>
          <li><a href={`${base}/#features`}>Features</a></li>
          <li><a href={`${base}/#download`}>Download</a></li>
          <li><a href={`${base}/changelog`}>Changelog</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <h3 class="footer-heading">Community</h3>
        <ul>
          <li><a href={githubURL} target="_blank" rel="noopener noreferrer">GitHub</a></li>
          <li><a href={`${githubURL}/discussions`} target="_blank" rel="noopener noreferrer">Discussions</a></li>
          <li><a href={`${githubURL}/issues`} target="_blank" rel="noopener noreferrer">Report a bug</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <h3 class="footer-heading">Legal</h3>
        <ul>
          <li><a href={`${base}/privacy-policy`}>Privacy policy</a></li>
          <li><a href={licenseURL} target="_blank" rel="noopener noreferrer">MIT license</a></li>
          <li><a href={`${githubURL}/security/policy`} target="_blank" rel="noopener noreferrer">Security</a></li>
        </ul>
      </div>
    </nav>
  </div>
  <div class="container footer-bottom">
    <p>© {year} iajen. Free and open source. No telemetry.</p>
  </div>
</footer>

<style>
  .footer {
    margin-top: var(--space-16);
    border-top: 1px solid var(--color-border);
    background-color: var(--color-surface);
    backdrop-filter: var(--blur-acrylic);
    -webkit-backdrop-filter: var(--blur-acrylic);
  }

  .footer-inner {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 2fr);
    gap: var(--space-10);
    padding-top: var(--space-10);
    padding-bottom: var(--space-8);
  }

  .footer-brand .brand-name {
    display: block;
    font-size: 18px;
    font-weight: var(--fw-semibold);
    color: var(--color-text);
    margin-bottom: var(--space-2);
  }

  .brand-tagline {
    color: var(--color-text-secondary);
    font-size: var(--fs-caption);
    max-width: 28ch;
  }

  .footer-nav {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-6);
  }

  .footer-heading {
    font-size: var(--fs-caption);
    font-weight: var(--fw-semibold);
    color: var(--color-text);
    margin-bottom: var(--space-3);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .footer-col ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .footer-col a {
    color: var(--color-text-secondary);
    font-size: var(--fs-caption);
  }

  .footer-col a:hover {
    color: var(--color-accent);
  }

  .footer-bottom {
    padding-block: var(--space-5);
    border-top: 1px solid var(--color-border);
  }

  .footer-bottom p {
    font-size: var(--fs-caption);
    color: var(--color-text-tertiary);
    max-width: none;
  }

  @media (max-width: 720px) {
    .footer-inner {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
    .footer-nav {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-5);
    }
  }

  @media (max-width: 480px) {
    .footer-nav {
      grid-template-columns: 1fr;
    }
  }
</style>
