---
export interface Props {
  /** YouTube video ID. When empty, an empty-state card is rendered instead of an iframe. */
  youtubeId?: string;
  title?: string;
}

const { youtubeId = '', title = 'See AuraShell in action' } = Astro.props;
const hasVideo = youtubeId.length > 0;
---

<section class="demo section" id="demo">
  <div class="container">
    <header class="section-header">
      <span class="section-eyebrow">Demo</span>
      <h2 class="section-title">{title}</h2>
    </header>

    <div class={`demo-frame ${hasVideo ? 'has-video' : 'empty-state'}`}>
      {hasVideo ? (
        <iframe
          src={`https://www.youtube-nocookie.com/embed/${youtubeId}`}
          title={title}
          loading="lazy"
          allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
        ></iframe>
      ) : (
        <div class="empty-content">
          <div class="play-icon" aria-hidden="true">
            <svg viewBox="0 0 64 64" width="64" height="64" fill="none">
              <circle cx="32" cy="32" r="30" stroke="currentColor" stroke-width="1.5" opacity="0.4"></circle>
              <polygon points="26,20 26,44 46,32" fill="currentColor"></polygon>
            </svg>
          </div>
          <p class="empty-title">Demo video — coming soon</p>
          <p class="empty-subtitle">A 60–90 second walkthrough lands here when the v0.1.0 demo recording is ready.</p>
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .demo-frame {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background-color: var(--color-surface);
    backdrop-filter: var(--blur-acrylic);
    -webkit-backdrop-filter: var(--blur-acrylic);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-card);
  }

  .demo-frame.has-video iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .demo-frame.empty-state {
    background: linear-gradient(180deg, var(--color-surface-elevated), var(--color-surface));
  }

  .empty-content {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    padding: var(--space-6);
    text-align: center;
  }

  .play-icon {
    color: var(--color-accent);
    margin-bottom: var(--space-2);
  }

  .empty-title {
    font-size: var(--fs-h3);
    color: var(--color-text);
    font-weight: var(--fw-semibold);
    max-width: none;
  }

  .empty-subtitle {
    color: var(--color-text-secondary);
    font-size: var(--fs-body);
    max-width: 44ch;
  }
</style>
